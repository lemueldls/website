{
  "name": "website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "nuxt dev",
    "fetch:meta": "node --experimental-strip-types scripts/fetch-meta.ts",
    "fetch:repos": "node --env-file-if-exists=.env --experimental-strip-types scripts/fetch-repos.ts",
    "fmt": "oxfmt app shared content.config.ts modules scripts nuxt.config.ts",
    "fmt:check": "oxfmt --check app shared content.config.ts modules scripts nuxt.config.ts",
    "gen:badges": "node --experimental-strip-types scripts/gen-badges.ts",
    "gen:sigil": "node --experimental-strip-types scripts/gen-sigil.ts",
    "generate": "nuxt generate",
    "lint": "oxlint app shared content.config.ts modules scripts",
    "lint:fix": "oxlint app shared content.config.ts modules scripts --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "typecheck": "nuxt typecheck && tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@iconify-json/griddy-icons": "^1.2.0",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/simple-icons": "^1.2.99",
    "@libsql/client": "^0.18.0",
    "@nuxt/content": "^3.16.1",
    "@nuxt/fonts": "^1.0.1",
    "@nuxt/icon": "^2.5.1",
    "@nuxt/image": "^2.1.0",
    "@nuxtjs/mdc": "^0.23.2",
    "@nuxtjs/seo": "^6.0.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "cloudflare": "^7.3.0",
    "drizzle-orm": "^0.45.4",
    "katex": "^0.19.0",
    "nanotar": "^0.3.0",
    "nuxt": "^4.6.1",
    "octokit": "^5.0.5",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "unifont": "^1.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@takumi-rs/core": "^2.15.2",
    "@takumi-rs/wasm": "^2.15.2",
    "@types/node": "^26.6.4",
    "better-sqlite3": "^13.0.3",
    "nuxt-og-image": "^7.0.7",
    "nuxtseo-devtools-host": "^1.0.2",
    "opentype.js": "^1.3.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright-core": "^1.64.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "remark-smartypants": "^3.0.3",
    "satori": "^0.47.1",
    "subset-font": "^2.9.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.12",
    "wrangler": "^4.149.0"
  },
  "packageManager": "pnpm@12.11.2"
}
