{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "vue", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2026": true
  },
  "ignorePatterns": [
    "node_modules/**",
    ".nuxt/**",
    ".output/**",
    "dist/**",
    "public/**",
    "pnpm-lock.yaml",
    ".wrangler/**",
    "**/nuxt-icon-*.mjs"
  ]
}
