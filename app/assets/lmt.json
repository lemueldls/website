{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "lmt",
  "displayName": "LMT",
  "fileTypes": ["lmt"],
  "scopeName": "source.lmt",
  "patterns": [
    { "include": "#comments" },
    { "include": "#directives" },
    { "include": "#code-block" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#let-bindings" },
    { "include": "#function-definitions" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#collections" },
    { "include": "#holes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.lmt",
          "match": "//.*$"
        },
        {
          "name": "comment.block.lmt",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "directives": {
      "patterns": [
        {
          "name": "constant.other.directive.lmt",
          "match": "@[a-zA-Z_:][a-zA-Z0-9_.-]*"
        }
      ]
    },
    "types": {
      "patterns": [{ "name": "entity.name.type.lmt", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }]
    },
    "code-block": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.lmt" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.braces.end.lmt" } },
      "patterns": [{ "include": "$self" }]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.lmt",
          "match": "\\b(if|else|while|for|in|return|break|continue)\\b"
        },
        {
          "name": "variable.parameter.it.lmt",
          "match": "\\b(it)\\b"
        },
        {
          "name": "keyword.declaration.lmt",
          "match": "\\b(let|import|include|as)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lmt",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.lmt",
          "match": "\\bnone\\b"
        },
        {
          "name": "constant.language.auto.lmt",
          "match": "\\bauto\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.lmt",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.lmt",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.lmt",
          "match": "\\b\\d+\\b"
        },
        {
          "name": "constant.numeric.float.lmt",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.unit.lmt",
          "match": "\\b\\d+(\\.\\d+)?(pt|mm|cm|in|em|pt|%|deg|rad|fr|s|ms)\\b"
        }
      ]
    },
    "let-bindings": {
      "patterns": [
        {
          "name": "meta.let.typed.lmt",
          "match": "\\b(let)\\s+([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(:)\\s*([a-zA-Z_][a-zA-Z0-9_-]*)",
          "captures": {
            "1": { "name": "keyword.declaration.lmt" },
            "2": { "name": "variable.other.assignment.lmt" },
            "3": { "name": "punctuation.separator.colon.lmt" },
            "4": { "name": "entity.name.type.lmt" }
          }
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "name": "meta.function.definition.lmt",
          "begin": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*\\(",
          "beginCaptures": {
            "1": { "name": "entity.name.function.lmt" }
          },
          "end": "\\)\\s*=",
          "patterns": [
            { "include": "#comments" },
            {
              "name": "meta.parameter.named.lmt",
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(:)",
              "captures": {
                "1": { "name": "variable.parameter.lmt" },
                "2": { "name": "punctuation.separator.colon.lmt" }
              }
            },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#variables" },
            { "include": "#constants" },
            { "include": "#strings" },
            { "include": "#numbers" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.lmt",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.lmt" }
          }
        },
        {
          "name": "meta.function.definition.lmt",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*\\(([^)]*)\\)\\s*\\s*=",
          "captures": {
            "1": { "name": "entity.name.function.lmt" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.lmt",
          "match": "==|!=|<=|>=|<|>|=>"
        },
        {
          "name": "keyword.operator.arithmetic.lmt",
          "match": "\\+|\\-|\\*|/|%"
        },
        {
          "name": "keyword.operator.logical.lmt",
          "match": "\\b(and|or|not|mod)\\b"
        },
        {
          "name": "keyword.operator.ascription.lmt",
          "match": "::"
        },
        {
          "name": "keyword.operator.never.lmt",
          "match": "!"
        },
        {
          "name": "punctuation.separator.pipe.lmt",
          "match": "\\|"
        },
        {
          "name": "punctuation.separator.comma.lmt",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.lmt",
          "match": ":"
        },
        {
          "name": "punctuation.separator.semicolon.lmt",
          "match": ";"
        }
      ]
    },
    "collections": {
      "patterns": [
        {
          "name": "meta.array.lmt",
          "begin": "\\[",
          "beginCaptures": { "0": { "name": "punctuation.section.brackets.begin.lmt" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.section.brackets.end.lmt" } },
          "patterns": [{ "include": "$self" }]
        },
        {
          "name": "meta.dictionary.lmt",
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.section.parentheses.begin.lmt" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.section.parentheses.end.lmt" } },
          "patterns": [
            {
              "match": "\\b([a-zA-Z_][a-zA-Z0-9_-]*)\\s*(:)",
              "captures": {
                "1": { "name": "constant.other.key.lmt" },
                "2": { "name": "punctuation.separator.colon.lmt" }
              }
            },
            { "include": "$self" }
          ]
        }
      ]
    },
    "holes": {
      "patterns": [
        {
          "name": "keyword.other.hole.lmt",
          "match": "\\?\\?|\\?"
        }
      ]
    }
  }
}
